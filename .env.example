# # LLM Provider
# LLM_PROVIDER=groq
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# # Groq Configuration (recommended for free tier)
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=

# Alternative providers (uncomment one)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Agents SDK
AGENTS_SDK_TRACING_ENABLED=true
AGENTS_SDK_TRACE_EXPORT=console
AGENTS_SDK_TRACE_FILE=traces/kisan_dost.jsonl

# Data
DATA_DIR=data
USE_REAL_APIS=false

# External APIs
OPEN_METEO_TIMEOUT=10
AMIS_PUNJAB_TIMEOUT=15

# Session
SESSION_BACKEND=sqlite
SESSION_DB_PATH=data/sessions.db
SESSION_TTL_HOURS=24

# Safety
MAX_PESTICIDE_DOSAGE_ML_PER_ACRE=2000.0
BANNED_PESTICIDES=endosulfan,monocrotophos,phosphamidon,methyl_parathion

# UI
DEFAULT_LANGUAGE=en
ENABLE_URDU_RENDERING=true
CONSOLE_WIDTH=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/kisan_dost.log
LOG_FORMAT=json